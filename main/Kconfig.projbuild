# LVGL 内存分配器换挡: lv_conf_internal 认 int 型 CONFIG_LV_USE_STDLIB_MALLOC
# (1 = LV_STDLIB_CLIB), 但本组件版本的 Kconfig choice 没有提供该 int 转换器,
# 默认永远 builtin(固定 64KB 不可扩展池) —— 页面叠加时池耗尽,
# lv_malloc 返回 NULL, LVGL 9 样式代码 OOM 死循环/崩溃。
# 这里补一个 int 符号: 1 = CLIB malloc, LVGL 对象经 libc 分配,
# 配合 SPIRAM_MALLOC_ALWAYSINTERNAL=0 全部落 PSRAM。
config LV_USE_STDLIB_MALLOC
    int
    default 1
